# Required for the local administrator session. Use unique, strong values.
TORRENTFLOW_ADMIN_PASSWORD=change-this-password
TORRENTFLOW_SESSION_SECRET=replace-with-a-long-random-secret
# Set true only when this installation is served through HTTPS.
TORRENTFLOW_COOKIE_SECURE=false

# Optional integrations
TORRENTFLOW_QBITTORRENT_URL=http://nas.local:8080
TORRENTFLOW_QBITTORRENT_USERNAME=admin
TORRENTFLOW_QBITTORRENT_PASSWORD=replace-me
TORRENTFLOW_TELEGRAM_BOT_TOKEN=
TORRENTFLOW_TELEGRAM_CHAT_ID=

# Rotating SQLite backup policy
TORRENTFLOW_BACKUP_RETENTION=7
TORRENTFLOW_BACKUP_INTERVAL_SECONDS=86400

# Alert when the data volume has less than this percentage free.
TORRENTFLOW_DISK_FREE_THRESHOLD_PERCENT=10
